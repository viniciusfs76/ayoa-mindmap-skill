<opml version="2.0">
  <head>
    <title>Final da Copa do Mundo FIFA 2026 - Argentina x Espanha</title>
    <dateCreated>Thu, 16 Jul 2026 12:30:00 -0300</dateCreated>
    <ownerName>Vinicius Silva</ownerName>
  </head>
  <body>
    <outline text="&#127942; Final da Copa do Mundo FIFA 2026 - Argentina x Espanha" _color="#D4AF37">
      <outline text="&#128197; Jogo decisivo" _color="#2F80ED">
        <outline text="Domingo, 19 de julho de 2026"/>
        <outline text="New York New Jersey Stadium - East Rutherford, NJ"/>
        <outline text="15h local (EDT / UTC-4)"/>
        <outline text="Argentina defende o t&#237;tulo de 2022"/>
        <outline text="Espanha busca seu 2o t&#237;tulo, ap&#243;s 2010"/>
      </outline>
      <outline text="&#127462;&#127479; Caminho da Argentina" _color="#75AADB">
        <outline text="32 avos: 3-2 sobre Cabo Verde"/>
        <outline text="Oitavas: 3-2 sobre o Egito"/>
        <outline text="Quartas: 3-1 sobre a Su&#237;&#231;a"/>
        <outline text="Semifinal: 2-1 sobre a Inglaterra"/>
        <outline text="Virada na semi: Enzo 85', Mart&#237;nez 90+2'"/>
      </outline>
      <outline text="&#127466;&#127480; Caminho da Espanha" _color="#C60B1E">
        <outline text="32 avos: 3-0 sobre a &#193;ustria"/>
        <outline text="Oitavas: 1-0 sobre Portugal"/>
        <outline text="Quartas: 2-1 sobre a B&#233;lgica"/>
        <outline text="Semifinal: 2-0 sobre a Fran&#231;a"/>
        <outline text="Na semi: Oyarzabal 22' (p), Pedro Porro 58'"/>
      </outline>
      <outline text="&#11088; Protagonistas" _color="#9B51E0">
        <outline text="Lionel Messi - cria&#231;&#227;o, lideran&#231;a e bola parada"/>
        <outline text="Lautaro Mart&#237;nez - profundidade e gol decisivo"/>
        <outline text="Enzo Fern&#225;ndez - chegada e chute de m&#233;dia dist&#226;ncia"/>
        <outline text="Lamine Yamal - drible, amplitude e cria&#231;&#227;o"/>
        <outline text="Mikel Oyarzabal - 5 gols no torneio"/>
        <outline text="Rodri e Pedri - controle do meio-campo espanhol"/>
      </outline>
      <outline text="&#129504; Duelo t&#225;tico" _color="#27AE60">
        <outline text="Espanha: posse alta, press&#227;o p&#243;s-perda e amplitude"/>
        <outline text="Argentina: bloco adapt&#225;vel, transi&#231;&#227;o e experi&#234;ncia"/>
        <outline text="Zona-chave: Rodri/Pedri contra Enzo/Mac Allister"/>
        <outline text="Flancos: Yamal contra o lado esquerdo argentino"/>
        <outline text="Decis&#227;o prov&#225;vel nos detalhes e bolas paradas"/>
      </outline>
      <outline text="&#128202; N&#250;meros da campanha" _color="#F2994A">
        <outline text="Argentina: 11 gols e 6 sofridos no mata-mata"/>
        <outline text="Espanha: 8 gols e 1 sofrido no mata-mata"/>
        <outline text="Espanha sofreu seu &#250;nico gol nas quartas"/>
        <outline text="Argentina venceu 4 jogos de mata-mata por margem curta"/>
        <outline text="Oyarzabal marcou seu 5o gol na semifinal"/>
      </outline>
      <outline text="&#128293; Narrativas da final" _color="#EB5757">
        <outline text="Messi pode encerrar a Copa com bicampeonato seguido"/>
        <outline text="Yamal disputa a final tr&#234;s dias ap&#243;s completar 19 anos"/>
        <outline text="Choque entre experi&#234;ncia campe&#227; e nova gera&#231;&#227;o espanhola"/>
        <outline text="Reedi&#231;&#227;o do duelo de campe&#245;es de 2010 e 2022"/>
        <outline text="Final in&#233;dita: Argentina x Espanha"/>
      </outline>
      <outline text="&#10067; Perguntas decisivas" _color="#56CCF2">
        <outline text="A Argentina conseguir&#225; conter Yamal sem perder compacta&#231;&#227;o?"/>
        <outline text="A Espanha resistir&#225; &#224;s transi&#231;&#245;es e &#224; bola parada de Messi?"/>
        <outline text="Quem controlar&#225; o ritmo nos 20 minutos finais?"/>
        <outline text="Qual banco ter&#225; maior impacto se houver prorroga&#231;&#227;o?"/>
      </outline>
    </outline>
  </body>
