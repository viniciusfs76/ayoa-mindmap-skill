<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>World Cup Final 2026 - Argentina vs Spain</title></head>
  <body>
    <outline text="WORLD CUP FINAL 2026 - ARGENTINA VS SPAIN">
      <outline text="GAME">
        <outline text="Sunday, July 19, 2026"/>
        <outline text="New York New Jersey Stadium - East Rutherford"/>
        <outline text="3 PM EDT"/>
        <outline text="Argentina defends the 2022 title"/>
        <outline text="Spain seeks its second title after 2010"/>
      </outline>
      <outline text="ARGENTINA PATH">
        <outline text="Round of 32: 3-2 Cape Verde"/>
        <outline text="Round of 16: 3-2 Egypt"/>
        <outline text="Quarterfinal: 3-1 Switzerland"/>
        <outline text="Semifinal: 2-1 England"/>
        <outline text="Semifinal comeback: Enzo 85 min; Martinez 90+2"/>
      </outline>
      <outline text="SPAIN PATH">
        <outline text="Round of 32: 3-0 Austria"/>
        <outline text="Round of 16: 1-0 Portugal"/>
        <outline text="Quarterfinal: 2-1 Belgium"/>
        <outline text="Semifinal: 2-0 France"/>
        <outline text="Semifinal goals: Oyarzabal 22 pen; Porro 58"/>
      </outline>
      <outline text="STARS">
        <outline text="Lionel Messi - creation and leadership"/>
        <outline text="Lautaro Martinez - depth and decisive goal"/>
        <outline text="Enzo Fernandez - late runs and shooting"/>
        <outline text="Lamine Yamal - dribbling and chance creation"/>
        <outline text="Mikel Oyarzabal - five tournament goals"/>
        <outline text="Rodri and Pedri - midfield control"/>
      </outline>
      <outline text="TACTICS">
        <outline text="Spain: possession and counterpressing"/>
        <outline text="Argentina: adaptable block and transitions"/>
        <outline text="Key zone: Rodri and Pedri versus Enzo and Mac Allister"/>
        <outline text="Flank duel: Yamal against Argentina left side"/>
        <outline text="Set pieces may decide the final"/>
      </outline>
      <outline text="NUMBERS">
        <outline text="Argentina: 11 scored and 6 conceded in knockouts"/>
        <outline text="Spain: 8 scored and 1 conceded in knockouts"/>
        <outline text="Spain conceded only once in knockouts"/>
        <outline text="Argentina won four close knockout matches"/>
        <outline text="Oyarzabal scored his fifth in the semifinal"/>
      </outline>
      <outline text="STORYLINES">
        <outline text="Messi can win consecutive World Cups"/>
        <outline text="Yamal plays the final at age 19"/>
        <outline text="Champion experience versus Spain new generation"/>
        <outline text="Champions of 2010 and 2022 meet"/>
        <outline text="First Argentina versus Spain World Cup final"/>
      </outline>
      <outline text="KEY QUESTIONS">
        <outline text="Can Argentina contain Yamal without losing compactness?"/>
        <outline text="Can Spain resist Messi transitions and set pieces?"/>
        <outline text="Who controls the final twenty minutes?"/>
        <outline text="Which bench changes the game in extra time?"/>
      </outline>
    </outline>
  </body>
</opml>
